{
  "schemaVersion": 8,
  "stage": "high level design",
  "userFlows": [
    {
      "name": "Import a workbook",
      "steps": [
        {
          "id": 1,
          "text": "The user picks a workbook and starts the import."
        },
        {
          "id": 2,
          "text": "The app reads the workbook and parses each sheet, recording a warning for every cell it cannot read."
        },
        {
          "id": 3,
          "text": "The app reports the outcome, including the rows imported, the rows skipped, and any stage that failed."
        }
      ]
    },
    {
      "name": "Confirm the column mapping",
      "steps": [
        {
          "id": 1,
          "text": "The app proposes a column mapping for the sheet being imported."
        },
        {
          "id": 2,
          "text": "The user confirms the proposal or corrects it."
        },
        {
          "id": 3,
          "text": "The app coerces each cell using the confirmed mapping and records the mapped rows on the run."
        }
      ]
    }
  ],
