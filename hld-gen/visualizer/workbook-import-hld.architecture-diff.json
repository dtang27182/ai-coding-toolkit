    {
      "from": {
        "component": "Import Panel"
      },
      "to": {
        "class": "ImportOrchestrator",
        "method": "run"
      },
      "type": "dataflow",
      "dataDescription": "The selected workbook's path and the import options the user chose: target table, header row, and whether to replace existing rows.",
      "purpose": "Opens step 1 of Import a workbook. Nothing downstream runs until this arrives, and the options it carries decide how every later stage behaves.",
      "userFlow": true,
      "changeType": "modified"
    },
    {
      "from": {
        "class": "ImportOrchestrator",
        "method": "planStages"
      },
      "to": {
        "class": "WorkbookReader",
        "method": "open"
      },
      "type": "dataflow",
      "dataDescription": "The ordered stage plan: which sheets to open, in what order, and which may be skipped.",
      "purpose": "Fixes the read order before any I/O, so a failure in step 2 can name the stage it happened in rather than an arbitrary sheet.",
      "userFlow": true,
      "changeType": "modified"
    },
    {
      "from": {
        "class": "WorkbookReader",
        "method": "open"
      },
      "to": {
        "component": "Workbook File on Disk"
      },
      "type": "dataflow",
      "dataDescription": "A read request for the workbook at the selected path.",
      "purpose": "The only point at which the import touches the filesystem, so step 2 works from the file as it is on disk rather than anything cached.",
      "userFlow": true,
      "changeType": "unchanged"
    },
    {
      "from": {
        "component": "Workbook File on Disk"
      },
      "to": {
        "class": "WorkbookReader",
        "method": "open"
      },
      "type": "dataflow",
      "dataDescription": "The workbook's raw bytes, or a read error when the file is missing or locked.",
      "purpose": "Supplies the only content the import can be built from; a read error here ends the run before any sheet is parsed.",
      "userFlow": true,
      "changeType": "unchanged"
    },
    {
      "from": {
        "class": "WorkbookReader",
        "method": "readSheet"
      },
      "to": {
        "class": "SheetParser",
        "method": "parseRows"
      },
      "type": "dataflow",
      "dataDescription": "Decoded rows from one sheet, streamed in sheet order, each still holding raw cell text.",
      "purpose": "Streams rather than materialising the sheet, so step 2 can handle workbooks larger than memory.",
      "userFlow": true,
      "changeType": "modified"
    },
    {
      "from": {
        "class": "SheetParser",
        "method": "parseRows"
      },
      "to": {
        "class": "ParseDiagnostics",
        "method": "record"
      },
      "type": "dataflow",
      "dataDescription": "One warning per unreadable cell, carrying its sheet, row, column, and the raw text that failed.",
      "purpose": "Reports bad cells as they are found instead of dropping them, so step 3 can tell the user which rows were skipped and why.",
      "userFlow": true,
      "changeType": "added"
    },
    {
      "from": {
        "class": "ImportOrchestrator",
        "method": "run"
      },
      "to": {
        "class": "SheetMapper",
        "method": "mapSheet"
      },
      "type": "dataflow",
      "dataDescription": "The parsed sheet: its header row and the rows produced by parsing, typed where parsing succeeded.",
      "purpose": "Hands parsing's output to mapping, where sheet rows become records for the target table. This begins Confirm the column mapping.",
      "userFlow": true,
      "changeType": "added"
    },
    {
      "from": {
        "class": "SheetMapper",
        "method": "proposeColumns"
      },
      "to": {
        "class": "ColumnMatcher",
        "method": "match"
      },
      "type": "dataflow",
      "dataDescription": "Each header name paired with the target columns it might map to.",
      "purpose": "Produces a ranked proposal rather than a guess, so step 1 of Confirm the column mapping shows the user something worth correcting.",
      "userFlow": true,
      "changeType": "added"
    },
    {
      "from": {
        "class": "ColumnMatcher",
        "method": "scoreCandidate"
      },
      "to": {
        "class": "ColumnMatcher",
        "method": "normalizeHeader"
      },
      "type": "dataflow",
      "dataDescription": "One header name on its way to being lowercased, trimmed, and stripped of punctuation.",
      "purpose": "Keeps scoring stable across casing and spacing, so the same workbook exported twice proposes the same mapping.",
      "userFlow": true,
      "changeType": "added"
    },
    {
      "from": {
        "class": "SheetMapper",
        "method": "proposeColumns"
      },
      "to": {
        "component": "Mapping Review"
      },
      "type": "dataflow",
      "dataDescription": "The ranked mapping proposal: each header, its suggested target column, and a confidence score.",
      "purpose": "Shows the proposal before any data is coerced, which is what makes step 1 of Confirm the column mapping a review rather than a notification.",
      "userFlow": true,
      "changeType": "added"
    },
    {
      "from": {
        "component": "Mapping Review"
      },
      "to": {
        "class": "SheetMapper",
        "method": "mapSheet"
      },
      "type": "dataflow",
      "dataDescription": "The mapping the user accepted, including any column they redirected or excluded.",
      "purpose": "Returns the decision from step 2 of Confirm the column mapping. It is the contract every later coercion follows.",
      "userFlow": true,
      "changeType": "added"
    },
    {
      "from": {
        "class": "SheetMapper",
        "method": "mapSheet"
      },
      "to": {
        "class": "TypeCoercer",
        "method": "coerceCell"
      },
      "type": "dataflow",
      "dataDescription": "Each cell's raw value together with the target column type the confirmed mapping assigns it.",
      "purpose": "Applies the confirmed mapping value by value, producing the typed rows recorded in step 3 of Confirm the column mapping.",
      "userFlow": true,
      "changeType": "unchanged"
    },
    {
      "from": {
        "class": "ParseDiagnostics",
        "method": "summarize"
      },
      "to": {
        "class": "ImportOrchestrator",
        "method": "handleStageFailure"
      },
      "type": "dataflow",
      "dataDescription": "A per-stage summary of the collected warnings: counts by severity and the first few examples of each.",
      "purpose": "Turns accumulated warnings into a run-level verdict, so step 3 reports one outcome instead of a stream of individual failures.",
      "userFlow": true,
      "changeType": "added"
    },
    {
      "from": {
        "class": "ImportOrchestrator",
        "method": "handleStageFailure"
      },
      "to": {
        "component": "Import Panel"
      },
      "type": "dataflow",
      "dataDescription": "The run report: rows imported, rows skipped, and the stage that failed when one did.",
      "purpose": "Delivers the outcome of step 3. Until it arrives the panel still shows the import as running.",
      "userFlow": true,
      "changeType": "modified"
    },
    {
      "from": {
        "class": "ImportOrchestrator",
        "method": "run"
      },
      "to": {
        "class": "ImportOrchestrator"
      },
      "type": "state-update",
      "dataDescription": "Writes the finished run into `result`, replacing whatever the previous import left there.",
      "purpose": "Retains the outcome past the run so step 3 can redisplay it without repeating the import.",
      "userFlow": true,
      "changeType": "modified"
    },
    {
      "from": {
        "class": "WorkbookReader",
        "method": "readSheet"
      },
      "to": {
        "class": "WorkbookReader"
      },
      "type": "state-update",
      "dataDescription": "Writes the decoded sheet into `buffer`, replacing the sheet decoded before it.",
      "purpose": "Holds one sheet at a time so re-reading a sheet during step 2 does not decode the workbook again.",
      "userFlow": true,
      "changeType": "modified"
    },
    {
      "from": {
        "class": "SheetParser",
        "method": "parseRows"
      },
      "to": {
        "class": "ParseDiagnostics"
      },
      "type": "state-update",
      "dataDescription": "Appends each row's warnings to `entries`, which accumulates across every sheet in the run.",
      "purpose": "Accumulates rather than replaces, so step 3 can judge the run as a whole instead of reporting only the last sheet.",
      "userFlow": true,
      "changeType": "added"
    },
    {
      "from": {
        "class": "SheetMapper",
        "method": "mapSheet"
      },
      "to": {
        "class": "ImportOrchestrator"
      },
      "type": "state-update",
      "dataDescription": "Adds the sheet's mapped rows to `result`, alongside rows already recorded for earlier sheets.",
      "purpose": "Writes step 3 of Confirm the column mapping onto the shared run result, which is what the final report reads.",
      "userFlow": true,
      "changeType": "added"
    }
