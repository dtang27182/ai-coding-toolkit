{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Coding Toolkit Architecture Diff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stage", "classes", "components", "relationships"],
  "properties": {
    "schemaVersion": {
      "const": 5
    },
    "stage": {
      "const": "high level design"
    },
    "variableExposureCount": {
      "description": "Derived total; null when any inventory is unknown.",
      "type": ["integer", "null"],
      "minimum": 0
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/class"
      }
    },
    "components": {
      "description": "UI and external I/O endpoints participating in the dataflow. Use an empty array when none participate.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "changeType"],
      "properties": {
        "name": {
          "description": "Unique across classes and components; referenced by relationship endpoints.",
          "type": "string",
          "minLength": 1
        },
        "type": {
          "description": "A user-facing UI surface or an external I/O endpoint such as a network service, file, or browser storage.",
          "enum": ["ui", "external-io"]
        },
        "changeType": {
          "enum": ["added", "modified", "deleted", "unchanged"]
        }
      }
    },
    "class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "changeType", "methods", "variableExposure"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "changeType": {
          "enum": ["added", "modified", "deleted", "unchanged"]
        },
        "methods": {
          "description": "Every changed method and every unchanged method participating in the core logic's end-to-end dataflow.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/method"
          }
        },
        "variableExposureCount": {
          "description": "Derived class count; null when its inventory is unknown.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "variableExposure": {
          "description": "Existing declarations exposed to this class's changes; null when unknown.",
          "type": ["array", "null"],
          "items": {
            "$ref": "#/$defs/exposedVariable"
          }
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "changeType"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "changeType": {
          "enum": ["added", "modified", "deleted", "unchanged"]
        }
      }
    },
    "exposedVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "declaredAt"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["instance", "parameter", "local"]
        },
        "method": {
          "description": "Existing method containing the parameter or local.",
          "type": "string",
          "minLength": 1
        },
        "declaredAt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "line", "column"],
          "properties": {
            "file": {
              "description": "Canonical repository-relative path to the declaration in current code.",
              "type": "string",
              "minLength": 1
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "column": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "enum": ["parameter", "local"] }
            }
          },
          "then": { "required": ["method"] }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "instance" }
            }
          },
          "then": { "not": { "required": ["method"] } }
        }
      ]
    },
    "classEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": {
        "class": { "type": "string", "minLength": 1 }
      }
    },
    "methodEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "method"],
      "properties": {
        "class": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "componentEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component"],
      "properties": {
        "component": { "type": "string", "minLength": 1 }
      }
    },
    "dataflowEndpoint": {
      "oneOf": [
        { "$ref": "#/$defs/methodEndpoint" },
        { "$ref": "#/$defs/componentEndpoint" }
      ]
    },
    "compositionEndpoint": {
      "oneOf": [
        { "$ref": "#/$defs/classEndpoint" },
        { "$ref": "#/$defs/componentEndpoint" }
      ]
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "changeType"],
      "properties": {
        "from": {
          "description": "Explicit source reference, constrained by relationship type.",
          "type": "object"
        },
        "to": {
          "description": "Explicit target reference, constrained by relationship type.",
          "type": "object"
        },
        "type": {
          "enum": ["dataflow", "state-update", "composition"]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "changeType": {
          "enum": ["added", "modified", "deleted", "unchanged"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "dataflow" } } },
          "then": {
            "properties": {
              "from": { "$ref": "#/$defs/dataflowEndpoint" },
              "to": { "$ref": "#/$defs/dataflowEndpoint" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "state-update" } } },
          "then": {
            "required": ["label"],
            "properties": {
              "from": { "$ref": "#/$defs/methodEndpoint" },
              "to": { "$ref": "#/$defs/classEndpoint" },
              "label": { "description": "Name the instance variable being updated and describe the update." }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "composition" } } },
          "then": {
            "properties": {
              "from": { "$ref": "#/$defs/compositionEndpoint" },
              "to": { "$ref": "#/$defs/compositionEndpoint" }
            }
          }
        }
      ]
    }
  }
}
