{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Coding Toolkit Architecture Diff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stage", "classes", "relationships"],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "stage": {
      "const": "high level design"
    },
    "variableExposureCount": {
      "description": "Derived total; null when any inventory is unknown.",
      "type": ["integer", "null"],
      "minimum": 0
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/class"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    }
  },
  "$defs": {
    "class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "changeType", "methods", "variableExposure"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "changeType": {
          "enum": ["added", "modified", "deleted", "unchanged"]
        },
        "methods": {
          "description": "Every changed method and every unchanged method participating in the core logic's end-to-end dataflow.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/method"
          }
        },
        "variableExposureCount": {
          "description": "Derived class count; null when its inventory is unknown.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "variableExposure": {
          "description": "Existing declarations exposed to this class's changes; null when unknown.",
          "type": ["array", "null"],
          "items": {
            "$ref": "#/$defs/exposedVariable"
          }
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "changeType"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "changeType": {
          "enum": ["added", "modified", "deleted", "unchanged"]
        }
      }
    },
    "exposedVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "declaredAt"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["instance", "parameter", "local"]
        },
        "method": {
          "description": "Existing method containing the parameter or local.",
          "type": "string",
          "minLength": 1
        },
        "declaredAt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "line", "column"],
          "properties": {
            "file": {
              "description": "Canonical repository-relative path to the declaration in current code.",
              "type": "string",
              "minLength": 1
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "column": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "enum": ["parameter", "local"] }
            }
          },
          "then": { "required": ["method"] }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "instance" }
            }
          },
          "then": { "not": { "required": ["method"] } }
        }
      ]
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "changeType"],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["dataflow", "composition"]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "changeType": {
          "enum": ["added", "modified", "deleted", "unchanged"]
        }
      }
    }
  }
}
