{
  "name": "ai-coding-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install:codex": "node scripts/init.mjs --agent codex",
    "install:hld-gen-new": "node scripts/init.mjs --agent codex --tool hld-gen-new",
    "install:annotate-diff": "node scripts/init.mjs --agent codex --tool annotate-diff",
    "install:advanced-diff-viewer": "node scripts/init.mjs --agent codex --tool advanced-diff-viewer",
    "advanced-diff-viewer:generate": "node advanced-diff-viewer/generate-diff-index.mjs",
    "advanced-diff-viewer": "vite advanced-diff-viewer/visualizer",
    "build:advanced-diff-viewer": "vite build advanced-diff-viewer/visualizer",
    "visualizer": "vite hld-gen/visualizer",
    "hld-gen-new-visualizer": "vite common/impl-dataflow/visualizer",
    "build:visualizer": "vite build hld-gen/visualizer",
    "system-dataflow-visualizer": "vite common/system-dataflow/visualizer",
    "diff-visualizer": "vite annotate-diff/visualizer",
    "build:system-dataflow-visualizer": "vite build common/system-dataflow/visualizer",
    "build:diff-visualizer": "vite build annotate-diff/visualizer",
    "build:hld-gen-new-visualizer": "vite build common/impl-dataflow/visualizer",
    "validate": "node hld-gen/scripts/validate-architecture-diff.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
