{
  "name": "ai-coding-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "node scripts/init.mjs",
    "install:feature-design": "node scripts/init.mjs --agent codex --tool feature-design",
    "install:impl-design": "node scripts/init.mjs --agent codex --tool impl-design",
    "install:refactor-design": "node scripts/init.mjs --agent codex --tool refactor-design",
    "install:enrich-diff": "node scripts/init.mjs --agent codex --tool enrich-diff",
    "install:adv-diff": "node scripts/init.mjs --agent codex --tool advanced-diff-viewer",
    "install:user-journey-dataflow": "node scripts/init.mjs --agent codex --tool user-journey-dataflow",
    "install:ui-design": "node scripts/init.mjs --agent codex --tool ui-design",
    "adv-diff": "vite advanced-diff-viewer/visualizer",
    "hld-visualizer": "vite common/hld/visualizer",
    "diff-visualizer": "vite enrich-diff/visualizer",
    "user-journey-dataflow-viewer": "vite user-journey-dataflow/visualizer",
    "parse-ui-spec": "node common/ui-spec/parser/parse-spec.ts",
    "ui-spec-viewer": "vite common/ui-spec/viewer",
    "ui-spec-viewer:build": "vite build common/ui-spec/viewer"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "rolldown": "1.2.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
