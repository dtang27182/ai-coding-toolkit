 import { normalizeDiffOptions, compileGlobs, clamp } from './diffOptions.js';
 import { ChangeRequestError } from './errors.js';
 import { computeHunks, count, normalizePath } from './hunks.js';
 
 export class ChangeService {
   constructor({ repository, model, logger }) {
     this.repository = repository;
     this.model = model;
     this.logger = logger;
   }
+
+  configure(settings) {
+    // Called once at startup with the parsed Diff Settings File.
+    if (!settings) return this;
+    this.options = normalizeDiffOptions(settings);
+    this.ignore = compileGlobs(settings.ignore ?? []);
+    this.maxFiles = settings.maxFiles ?? 200;
+    this.options.contextLines = clamp(settings.contextLines ?? 3, 0, 20);
+    if (settings.renames === false) {
+      this.options.detectRenames = false;
+    }
+    this.logger?.debug('diff settings applied', { ignore: this.ignore.length });
+    return this;
+  }
+
+  async buildChangeSet({ paths, target }) {
+    const valid = this.#validatePaths(paths);
+    const { files, missing } = await this.repository.readSourceFiles(valid);
+    this.logger?.info('building change set', { files: files.length, missing: missing.length });
+    const entries = files.map((f) => diffFile(f, target, this.options));
+    const changeSet = {
+      entries,
+      changed: entries.length,
+      skipped: missing,
+      added: entries.reduce((n, e) => n + e.added, 0),
+      removed: entries.reduce((n, e) => n + e.removed, 0),
+    };
+    this.model.changes = changeSet;
+    return changeSet;
+  }
+
+  #validatePaths(paths) {
+    if (!Array.isArray(paths) || paths.length === 0) {
+      throw new ChangeRequestError('Select at least one file');
+    }
+    if (paths.length > this.maxFiles) {
+      throw new ChangeRequestError(`Select at most ${this.maxFiles} files`);
+    }
+    const unique = [...new Set(paths.map(normalizePath))];
+    return unique.filter((p) => !this.ignore.some((g) => g.test(p)));
+  }
 }
+
+function diffFile(file, target, options) {
+  const base = target.contentsOf(file.path) ?? '';
+  const hunks = computeHunks(base, file.text, options.contextLines);
+  return {
+    path: file.path,
+    hunks,
+    added: count(hunks, '+'),
+    removed: count(hunks, '-'),
+  };
+}
 
 export default ChangeService;
