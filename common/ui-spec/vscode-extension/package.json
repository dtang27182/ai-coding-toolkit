{
  "name": "ui-dsl",
  "displayName": "UI DSL",
  "description": "Syntax highlighting for .ui.dsl application specifications",
  "version": "0.1.0",
  "publisher": "hld-ui-tools",
  "private": true,
  "engines": {
    "vscode": "^1.80.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "ui-dsl",
        "aliases": ["UI DSL"],
        "extensions": [".ui.dsl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ui-dsl",
        "scopeName": "source.ui-dsl",
        "path": "./syntaxes/ui-dsl.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.typescript": "typescript"
        }
      }
    ]
  }
}
