{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI DSL parser output",
  "description": "The JSON structure returned by parseSpec. This schema does not validate embedded code or references between pages, state, and backend methods.",
  "type": "object",
  "required": ["id", "content_state", "backend_apis", "pages"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "content_state": {
      "type": "object",
      "required": ["initialization"],
      "properties": {
        "initialization": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "backend_apis": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/backend" }
    },
    "pages": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/page" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "backend": {
      "type": "object",
      "required": ["methods"],
      "properties": {
        "description": { "type": "string" },
        "methods": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/method" }
        }
      },
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "required": ["signature"],
      "properties": {
        "signature": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": ["elements"],
      "properties": {
        "description": { "type": "string" },
        "elements": {
          "type": "array",
          "items": { "$ref": "#/$defs/element" }
        }
      },
      "additionalProperties": false
    },
    "element": {
      "oneOf": [
        { "$ref": "#/$defs/container" },
        { "$ref": "#/$defs/leafElement" }
      ]
    },
    "container": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "container" },
        "description": { "type": "string" },
        "elements": {
          "type": "array",
          "items": { "$ref": "#/$defs/element" }
        }
      },
      "additionalProperties": false
    },
    "leafElement": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["button", "text_field", "text_area", "link", "text", "custom"]
        },
        "io": {
          "description": "Data direction relative to the user. The parser sets it from kind: button, text_field, and text_area are input; text is output; link and custom are input_output.",
          "enum": ["input", "output", "input_output"]
        },
        "description": { "type": "string" },
        "on_click": { "type": "string" },
        "url": { "type": "string" },
        "content": { "type": "string", "minLength": 1 },
        "reads": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  }
}
