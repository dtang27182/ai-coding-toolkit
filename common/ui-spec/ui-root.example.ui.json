{
  "id": "ui_root",
  "content_state": {
    "initialization": [
      "let authenticated_provider = 'none';",
      "let chat_transcript = [];"
    ]
  },
  "backend_apis": {
    "chat_manager": {
      "description": "Keep the selected provider's API key and chat history in memory. Generate replies with a GPT Terra model through OpenAI or OpenRouter, depending on the selected provider.",
      "methods": {
        "auth_open_ai": {
          "signature": "auth_open_ai(api_key: string): void",
          "description": "Save the OpenAI API key and select OpenAI as the provider."
        },
        "auth_open_router": {
          "signature": "auth_open_router(api_key: string): void",
          "description": "Save the OpenRouter API key and select OpenRouter as the provider."
        },
        "sign_out": {
          "signature": "sign_out(): void",
          "description": "Remove the saved API key and set the provider to none."
        },
        "get_provider": {
          "signature": "get_provider(): 'none' | 'open_ai' | 'open_router'",
          "description": "Return the selected provider."
        },
        "send_message": {
          "signature": "send_message(content: string): { role: 'user' | 'assistant'; content: string }",
          "description": "Add the user message to the stored chat history and return a model reply using the selected provider."
        },
        "reset_chat": {
          "signature": "reset_chat(): void",
          "description": "Clear the stored chat history."
        }
      }
    }
  },
  "pages": {
    "provider_selection": {
      "elements": [
        {
          "id": "select_open_router",
          "kind": "button",
          "io": "input",
          "on_click": "navigate('open_router_sign_in');"
        },
        {
          "id": "select_open_ai",
          "kind": "button",
          "io": "input",
          "on_click": "navigate('open_ai_sign_in');"
        }
      ]
    },
    "open_router_sign_in": {
      "elements": [
        {
          "id": "back_to_providers",
          "kind": "button",
          "io": "input",
          "on_click": "navigate('provider_selection');"
        },
        {
          "id": "api_key",
          "kind": "text_field",
          "io": "input"
        },
        {
          "id": "save_key",
          "kind": "button",
          "io": "input",
          "on_click": "chat_manager.auth_open_router(api_key); authenticated_provider = 'open_router'; navigate('chat_page');"
        }
      ]
    },
    "open_ai_sign_in": {
      "elements": [
        {
          "id": "back_to_providers",
          "kind": "button",
          "io": "input",
          "on_click": "navigate('provider_selection');"
        },
        {
          "id": "api_key",
          "kind": "text_field",
          "io": "input"
        },
        {
          "id": "save_key",
          "kind": "button",
          "io": "input",
          "on_click": "chat_manager.auth_open_ai(api_key); authenticated_provider = 'open_ai'; navigate('chat_page');"
        }
      ]
    },
    "chat_page": {
      "elements": [
        {
          "id": "settings",
          "kind": "container",
          "elements": [
            {
              "id": "help",
              "kind": "link",
              "io": "input_output",
              "url": "https://www.openworkbookai.org/help"
            },
            {
              "id": "signed_in_provider",
              "kind": "text",
              "io": "output",
              "content": "authenticated_provider"
            },
            {
              "id": "sign_out",
              "kind": "button",
              "io": "input",
              "on_click": "chat_manager.sign_out(); authenticated_provider = 'none'; navigate('provider_selection');"
            }
          ]
        },
        {
          "id": "clear_chat",
          "kind": "button",
          "io": "input",
          "on_click": "chat_manager.reset_chat(); chat_transcript = [];"
        },
        {
          "id": "transcript",
          "kind": "custom",
          "description": "Display the conversation in order, distinguish user and assistant messages, and keep new messages in view.",
          "io": "input_output",
          "reads": [
            "chat_transcript"
          ]
        },
        {
          "id": "message",
          "kind": "text_area",
          "io": "input"
        },
        {
          "id": "send",
          "kind": "button",
          "io": "input",
          "on_click": "chat_transcript = [...chat_transcript, { role: 'user', content: message }]; const reply = chat_manager.send_message(message); chat_transcript = [...chat_transcript, reply];"
        }
      ]
    }
  }
}
