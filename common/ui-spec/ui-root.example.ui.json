    },
    {
      "kind": "dataflow",
      "from": "e:open_ai_sign_in/api_key",
      "to": "m:chat_manager.auth_open_ai"
    },
    {
      "kind": "dataflow",
      "from": "e:open_ai_sign_in/save_key",
