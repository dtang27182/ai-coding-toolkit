{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Coding Toolkit Change Structure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stage", "classes", "relationships"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "stage": {
      "enum": ["high level design", "implementation plan", "diff review"]
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/class"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    }
  },
  "$defs": {
    "class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "changeType", "methods"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "changeType": {
          "enum": ["added", "modified", "unchanged"]
        },
        "coreChange": {
          "type": "boolean"
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/method"
          }
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "changeType"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "changeType": {
          "enum": ["added", "modified"]
        },
        "coreChange": {
          "type": "boolean"
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "changeType"],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["dataflow", "composition"]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "changeType": {
          "enum": ["added", "modified", "unchanged"]
        }
      }
    }
  }
}
